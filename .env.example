# Copy to .env (never commit .env)
DOMAIN=live.meta-note-ex.com
MTX_IMAGE=bluenviron/mediamtx:1.21.0
# Bitrate watchdog: 合計ingress上限。Topaz既定最大~2320k(映像2000+音声320)のため
# バースト誤検出防止に2500既定、5s間隔x3回(約15s)持続でkick。必要に応じ調整。
MAX_TOTAL_KBPS=2500
POLL_INTERVAL=5
VIOLATION_LIMIT=3
# Optional: Slack-compatible webhook POSTed when watchdog-health.sh restarts watchdog
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# P1 TLS/RTSPS用 (MVPでは未使用)
# ACME_EMAIL=admin@meta-note-ex.com
